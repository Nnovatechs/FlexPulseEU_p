# Public application metadata
NEXT_PUBLIC_APP_NAME=FlexPulseEU
# Local: http://localhost:3000
# Production: use the canonical Vercel domain, including https and no trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase Auth foundation
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase key used by internal jobs and public survey submission.
# Never expose this value to the browser.
SUPABASE_SECRET_KEY=
# Shared secret required by /api/internal/* job/debug endpoints.
INTERNAL_JOB_SECRET=
# Required for Vercel Cron deployments so scheduled internal workers can authenticate.
# Vercel sends this value as an Authorization bearer token to cron routes.
CRON_SECRET=

# Server-side placeholders for future integrations
SERVER_INTERNAL_API_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Required with NEXT_PUBLIC_TURNSTILE_SITE_KEY to enable Turnstile on public
# survey submissions. Vercel Production fails closed if either key is missing.
TURNSTILE_SECRET_KEY=
# Vercel Production requires both keys automatically. Set this to 1 to enforce
# the same fail-closed behavior in another environment.
TURNSTILE_REQUIRED=0
SURVEY_GENERATOR_DEBUG=0
ANALYTICS_SANDBOX_ALLOWED_EMAILS=your@email.com

# Keep account creation closed by default. Developers may set this to open only
# in a local or isolated Preview environment when signup testing is needed.
SIGNUP_MODE=closed

# Public legal disclosure placeholders for hosted deployments.
# Configure these per deployment; do not hardcode real operator details in source.
# Legacy/default survey-controller values. New surveys use the owner's Privacy
# Settings and retain these values only as a fallback for older publications.
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_CONTACT_EMAIL=


LEGAL_CONTROLLER_COUNTRY=European Union
# Legal name of the platform operator/processor shown on the global /privacy page.
LEGAL_PROCESSOR_NAME=FlexPulseEU
# Registered address of that same platform operator/processor, used in the DPA.
LEGAL_PROCESSOR_ADDRESS=
# Platform privacy contact. Also used as the legacy fallback when needed.
LEGAL_PRIVACY_EMAIL=
LEGAL_PRIVACY_URL=/privacy
LEGAL_COOKIES_URL=/cookies
LEGAL_CONSENT_VERSION=d2-2026-06-21
LEGAL_PRIVACY_NOTICE_VERSION=d2-2026-06-21
LEGAL_COOKIE_NOTICE_VERSION=d2-2026-06-21

# Keep the publication gate disabled until the DPA migration is applied, the
# Processor identity is complete, and the final wording has been legally approved.
DPA_REQUIRED=0

# Raw country/postal input retention. Keep 72 for normal operation; the
# controlled Stage 3 validation environment may temporarily use 168 (7 days)
# when the matching privacy notice version documents that period.
RAW_LOCATION_RETENTION_HOURS=72

# Do not commit real credentials.
# Use local env files, Vercel project variables, or your hosting platform.
