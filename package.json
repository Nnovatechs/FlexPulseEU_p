{
  "name": "flexpulseeu",
  "version": "0.1.0",
  "private": true,
  "description": "Foundation repository for FlexPulseEU with secure defaults, governance, and quality checks.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "eval:validation": "vitest run tests/evals/surveys/validation",
    "eval:translation": "vitest run tests/evals/surveys/translation",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.1",
    "next": "^16.1.6",
    "openai": "^6.31.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
