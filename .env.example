# Public app
NEXT_PUBLIC_APP_NAME=FlexPulseEU
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Internal jobs
INTERNAL_JOB_SECRET=
CRON_SECRET=

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Public survey protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=0
RECRUITMENT_ID_HMAC_SECRET=

# Auth and access
SIGNUP_MODE=closed
TERMS_REQUIRED=0

# Debug and internal tooling
SURVEY_GENERATOR_DEBUG=0
ANALYTICS_SANDBOX_ENABLED=
ANALYTICS_SANDBOX_ALLOWED_EMAILS=your@email.com

# Hosted platform legal config
LEGAL_PROCESSOR_NAME=FlexPulseEU
LEGAL_PROCESSOR_ADDRESS=
LEGAL_PRIVACY_EMAIL=
LEGAL_PRIVACY_URL=/privacy
LEGAL_COOKIES_URL=/cookies
LEGAL_CONSENT_VERSION=d2-2026-06-21
LEGAL_PRIVACY_NOTICE_VERSION=d2-2026-06-21
LEGAL_COOKIE_NOTICE_VERSION=d2-2026-06-21

# Legacy fallback for surveys published before owner-level privacy settings
LEGAL_CONTROLLER_NAME=
LEGAL_CONTROLLER_CONTACT_EMAIL=
LEGAL_CONTROLLER_COUNTRY=European Union

# Optional gates
DPA_REQUIRED=0

# Response retention
RAW_LOCATION_RETENTION_HOURS=72
